# Copy to .env.local (web app) — never commit real values.
DATABASE_URL=postgres://fa_dev:fa_dev_password@127.0.0.1:5433/footballanalyzer
TEST_DATABASE_URL=postgres://fa_dev:fa_dev_password@127.0.0.1:5433/footballanalyzer_test
TEST_S3_BUCKET=fa-videos-test
APP_ORIGIN=http://localhost:3000

# Object storage (local SeaweedFS from docker-compose). Production: Cloudflare R2 or AWS S3.
S3_ENDPOINT=http://127.0.0.1:8333
# Endpoint browsers use for presigned URLs (differs from S3_ENDPOINT only behind proxies/containers).
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=fa-videos-dev
S3_ACCESS_KEY_ID=fa_dev_access_key
S3_SECRET_ACCESS_KEY=fa_dev_secret_key_local_only
S3_FORCE_PATH_STYLE=true

# Clerk: leave empty in development to use keyless mode (temporary dev instance).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Clerk webhook (optional in development). From the Clerk dashboard → Webhooks.
# CLERK_WEBHOOK_SIGNING_SECRET=
